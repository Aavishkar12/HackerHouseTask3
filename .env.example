# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real keys.

# --- Stage 1 (face ID) and Stage 2 (search) need NO API key at all. ---
# Stage 2 uses Playwright browser automation against Yandex/Google Images
# directly (see scripts/find_match.py and README.md, "Why browser
# automation instead of an API" for why: Google Cloud Vision required a
# billing deposit, SerpApi blocked phone verification, TinEye has no free
# tier). Nothing below is needed to run Stages 1-2.

# --- Stage 3: blockchain (fill in once Stage 3 is built) ---
# RPC_URL=              # e.g. a Polygon Amoy or Sepolia testnet RPC endpoint
# PRIVATE_KEY=          # testnet wallet private key — NEVER a mainnet key with real funds
# CONTRACT_ADDRESS=     # filled in after the contract is deployed

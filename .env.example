# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored — never commit real keys.

# --- Stage 2: Google Cloud Vision (web detection) ---
# Simplest option: an API key from
#   Google Cloud Console -> APIs & Services -> Credentials -> Create API key
# Restrict it to the "Cloud Vision API" before using it.
GOOGLE_VISION_API_KEY=

# Alternative to the API key: path to a service-account JSON file.
# Only one of these is needed.
# GOOGLE_APPLICATION_CREDENTIALS=./gcloud-key.json

# --- Stage 3: blockchain (filled in later) ---
# RPC_URL=
# PRIVATE_KEY=
# CONTRACT_ADDRESS=
